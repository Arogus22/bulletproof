{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/framework-guide.py\"",
            "timeout": 15,
            "statusMessage": "Bulletproof: classifying the project..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/exit-lock-guard.py\"",
            "timeout": 10,
            "statusMessage": "Bulletproof: checking the green stamp..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/deploy-guard.py\"",
            "timeout": 10,
            "statusMessage": "Bulletproof: deploy guard (layer 3)..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/db-guard.py\"",
            "timeout": 10,
            "statusMessage": "Bulletproof: production database guard (layer 3)..."
          }
        ]
      },
      {
        "matcher": "d1|mcp__.*cloudflare",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/db-guard.py\"",
            "timeout": 10,
            "statusMessage": "Bulletproof: database guard for MCP tools (layer 3)..."
          }
        ]
      }
    ]
  }
}
